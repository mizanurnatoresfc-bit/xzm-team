{
  "name": "XZM-TEAM-erp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test:smoke": "node tests/smoke.mjs",
    "test:parser": "node --experimental-strip-types --test tests/reportParser.test.mjs",
    "test:nav": "node --experimental-strip-types --test tests/navAccess.test.mjs",
    "test:routes": "node --experimental-strip-types --test tests/routeModule.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/push-notifications": "^7.0.6",
    "@capacitor/status-bar": "^7.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
